=\"padding: 0; margin: 0;\"><span typeof=\"mw:File\"><span><img src=\"https://stardewvalleywiki.com/mediawiki/images/en/thumb/d/d4/Caroline_Icon.png/24px-Caroline_Icon.png\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\" srcset=\"https://stardewvalleywiki.com/mediawiki/images/en/d/d4/Caroline_Icon.png 1.5x\" /></span></span> <a href=\"/%E5%8D%A1%E6%B4%9B%E7%90%B3\" title=\"卡洛琳\">卡洛琳</a>（母亲）</p>\n</td></tr>\n<tr>\n<td id=\"infoboxsection\">可结婚对象\n</td>\n<td id=\"infoboxdetail\">是\n</td></tr>\n<tr>\n<td id=\"infoboxsection\">诊所预约日\n</td>\n<td id=\"infoboxdetail\"><span style=\"display:inline; margin-right:0;\"><span typeof=\"mw:File\"><span><img src=\"https://stardewvalleywiki.com/mediawiki/images/en/thumb/9/9c/Spring.png/24px-Spring.png\" decoding=\"async\" width=\"24\" height=\"16\" class=\"mw-file-element\" srcset=\"https://stardewvalleywiki.com/mediawiki/images/en/thumb/9/9c/Spring.png/36px-Spring.png 1.5x, https://stardewvalleywiki.com/mediawiki/images/en/9/9c/Spring.png 2x\" /></span></span>&#160;<a href=\"/%E6%98%A5%E5%AD%A3\" title=\"春季\">春季</a>&#8201;4日</span>\n</td></tr>\n<tr>\n<td id=\"infoboxsection\">最爱的礼物\n</td>\n<td id=\"infoboxdetail\"><style data-mw-deduplicate=\"TemplateStyles:r19680\">.mw-parser-output .nametemplate{margin:2px 5px 1px 2px;display:block;white-space:nowrap}.mw-parser-output .nametemplateinline{margin:2px 0 1px 2px;display:inline;white-space:nowrap}.mw-parser-output .nametemplate img,.mw-parser-output .nametemplateinline img{max-width:none}</style><span class=\"nametemplate\"><span typeof=\"mw:File\"><span><img src=\"https://stardewvalleywiki.com/mediawiki/images/en/thumb/2/2e/Amethyst.png/24px-Amethyst.png\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\" srcset=\"https://stardewvalleywiki.com/mediawiki/images/en/thumb/2/2e/Amethyst.png/36px-Amethyst.png 1.5x, https://stardewvalleywiki.com/mediawiki/images/en/2/2e/Amethyst.png 2x\" /></span></span> <a href=\"/%E7%B4%AB%E6%B0%B4%E6%99%B6